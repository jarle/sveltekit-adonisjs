{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2022",
		"module": "node16",
		"moduleResolution": "node16",
		"baseUrl": ".",
		"paths": {
			"@sveltejs/kit": ["../kit/types/index"]
		}
	},
	"include": [
		"ambient.d.ts",
		"index.js",
		"src/**/*.js",
		"tests/**/*.js",
		"tests/**/*.ts",
		"internal.d.ts",
		"utils.js"
	]
}
